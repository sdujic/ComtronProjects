# Razvojno okolje (SQLite) - deluje takoj brez namestitve PostgreSQL:
DATABASE_URL="file:./dev.db"

# Za produkcijo/PostgreSQL zamenjaj provider v prisma/schema.prisma iz "sqlite" v "postgresql"
# in nastavi npr.:
# DATABASE_URL="postgresql://uporabnik:geslo@localhost:5432/narocanje?schema=public"

# Prijava v /admin (glej middleware.ts, src/lib/admin-seja.ts). To je "korenski" admin -
# geslo v čistem besedilu v .env (NE hashirano) - namerna poenostavitev, ne pozabljena
# varnostna luknja - deluje VEDNO, tudi na sveži bazi, da se admin ne more sam zakleniti
# ven. Dodatne admin uporabnike (s pravilno hashiranimi gesli, bcrypt) dodajaš prek UI na
# /admin/nastavitve, razdelek "Admin uporabniki" - ni jih treba dodajati sem.
ADMIN_EMAIL="admin@admin.si"
ADMIN_PASSWORD="123"
# Naključen, skrivnostni niz za podpisovanje prijavnega piškotka (HMAC-SHA256) - v
# produkciji nastavi na dolg naključen niz, drugačen od te privzete vrednosti.
ADMIN_SESSION_SECRET="spremeni-me-v-produkciji"

# TronOfficeAPI (TRONxERP integracija, glej ../TronOfficeAPI-referenca.md).
# Če ti dve spremenljivki nista nastavljeni, se uporabi mock adapter (samo
# logira v konzolo) - aplikacija deluje normalno tudi brez njiju.
# TRONXERP_API_BASE_URL="https://xerp.comtron.si/tronofficeapi"
# TRONXERP_API_USERNAME=""
# TRONXERP_API_PASSWORD=""
# TRONXERP_API_BUSTORE_ID=""
# TRONXERP_API_BUNIT_ID=""
# TRONXERP_API_DOC_TYPE_ID="EPN"
# TRONXERP_API_DEFAULT_TAX_RATE_ID=""
# TRONXERP_API_DEFAULT_CUSTOMER_ID="0"
